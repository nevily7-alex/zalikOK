{
  "name": "zalikok-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:dev": "node scripts/dev-db.mjs",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:generate": "prisma generate",
    "storage:check": "tsx --conditions=react-server scripts/check-storage.ts",
    "vercel:env": "node scripts/vercel-env.mjs",
    "setup:telegram": "node scripts/setup-telegram.mjs",
    "setup:supabase": "node scripts/setup-supabase-env.mjs",
    "db:check-rls": "tsx --conditions=react-server scripts/check-rls.ts",
    "admin:create": "tsx --conditions=react-server scripts/create-manager.ts",
    "cleanup": "tsx --conditions=react-server scripts/cleanup.ts",
    "outbox:run": "tsx --conditions=react-server scripts/run-outbox.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1144.0",
    "@aws-sdk/s3-request-presigner": "^3.1144.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "better-auth": "^1.7.7",
    "dotenv": "^18.0.5",
    "next": "^16.3.8",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "embedded-postgres": "^17.10.0-beta.17",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "prisma": "^7.10.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "@embedded-postgres/windows-x64@17.10.0-beta.17": true,
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.0": true,
    "unrs-resolver@1.12.2": true
  }
}
