# ЗалікОк — приклад змінних середовища. Скопіюйте у .env (локально) або задайте в системі хостингу.
# Секрети ніколи не комітяться. Значення нижче — лише імена/приклади для локальної розробки.

# --- Загальне ---
# NODE_ENV задає Next.js (dev/build/start); у .env не вказуйте
# Публічна адреса застосунку (домен ще не визначено — залиште локальну для розробки)
APP_URL=http://localhost:3000

# --- База даних (PostgreSQL) ---
# Локально: `npm run db:dev` піднімає embedded-postgres на цьому порту
DATABASE_URL=postgresql://zalikok:zalikok@localhost:54329/zalikok
# Supabase: застосунок — через пул (Connect → Transaction pooler, порт 6543), без ?sslmode у рядку:
#   DATABASE_URL=postgresql://postgres.<ref>:<ПАРОЛЬ>@aws-0-<region>.pooler.supabase.com:6543/postgres
#   DATABASE_SSL=verify   (перевірка сертифіката; вбудовано Supabase Root CA. require = шифрування без перевірки)
# Міграції — через пряме підключення (Connect → Direct connection / Session pooler :5432), тут sslmode=require потрібен:
#   DIRECT_URL=postgresql://postgres:<ПАРОЛЬ>@db.<ref>.supabase.co:5432/postgres?sslmode=require
# Інший провайдер БД: DATABASE_SSL=verify + DATABASE_SSL_CA=<PEM сертифіката, переноси рядків записані як літеральні \n>
DIRECT_URL=
DATABASE_SSL=
DATABASE_SSL_CA=

# --- Авторизація менеджера (better-auth) ---
# Мінімум 32 символи, згенеруйте: openssl rand -base64 32
AUTH_SECRET=
# Для скрипта `npm run admin:create` (не зберігаються в застосунку)
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# --- Сховище файлів ---
# local = закрита тека на диску (лише розробка); s3 = S3-сумісне приватне сховище
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.data/storage
# Для STORAGE_DRIVER=s3:
# Supabase Storage: S3_ENDPOINT=https://<ref>.storage.supabase.co/storage/v1/s3  S3_REGION=<регіон проєкту, напр. eu-central-1>
#                   S3_FORCE_PATH_STYLE=true, bucket — приватний (Public bucket вимкнено)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# --- Перевірка файлів ---
# off  = AV не налаштовано: файли лишаються scanStatus=pending, завантаження менеджером заблоковано
# clamav = перевірка через clamd (потрібні CLAMAV_HOST / CLAMAV_PORT)
# dev-trust = ТІЛЬКИ development: позначає файли як clean після перевірки сигнатур
UPLOAD_SCAN_MODE=off
CLAMAV_HOST=
CLAMAV_PORT=3310

# --- Сповіщення менеджеру ---
# У development завжди вимкнено. Увімкнути лише у production після перевірки на власному отримувачі.
NOTIFICATIONS_ENABLED=false
# Лише для тесту на власному чаті під час `npm run dev` (у development за замовчуванням нічого не надсилається)
ALLOW_DEV_NOTIFICATIONS=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_MANAGER_CHAT_ID=

# --- Розклад (cron) ---
# Секрет для /api/cron/outbox (повтори сповіщень) і /api/cron/cleanup (очищення). Без нього ендпоінти вимкнені (404).
# Планувальник має надсилати заголовок `Authorization: Bearer <CRON_SECRET>` (Vercel Cron робить це сам).
CRON_SECRET=

# --- Обмеження частоти та зберігання ---
# Порожньо = in-memory (лише один процес). Для production потрібне спільне сховище (Postgres за замовчуванням).
RATE_LIMIT_STORAGE_URL=
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MINUTES=15
# Лише якщо хостинг відомий і довіряє X-Forwarded-For / заголовку власного проксі
TRUSTED_PROXY_HEADER=
FILE_RETENTION_DAYS=180
ABANDONED_UPLOAD_HOURS=24

# --- Аналітика (за замовчуванням вимкнена, див. content/site-config.json) ---
# NEXT_PUBLIC_ANALYTICS_ENDPOINT=
